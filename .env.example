# Variables d'environnement (AlwaysData : Administration > Environnement / ou .htaccess SetEnv)
DB_HOST=postgresql-moncompte.alwaysdata.net
DB_PORT=5432
DB_NAME=moncompte_leitner
DB_USER=moncompte
DB_PASSWORD=change-me
# Mot de passe de l'application : hash généré par  php -r 'echo password_hash("monmotdepasse", PASSWORD_DEFAULT);'
APP_PASSWORD_HASH=
# Racine HTTPS des versions audio des cours (ex. bucket S3 public). Fichier attendu : <titre du document>.mp3
# Laisser vide pour ne pas afficher de lecteur audio.
AUDIO_BASE_URL=https://always-leitner.s3.eu-west-3.amazonaws.com/cap-esthetique
